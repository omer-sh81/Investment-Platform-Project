<Window x:Class="Investment_Platform_Project.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="כניסה למערכת מסחר" Height="520" Width="420" HorizontalAlignment="center" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="#131722" FontFamily="Segoe UI">

    <Grid>
        <!-- רקע חלון ראשי - כחול-פחם עמוק של פלטפורמות מסחר (#131722) -->

        <!-- כרטיס התחברות מרכזי -->
        <Border Width="340" Height="440" Background="#1E222D" CornerRadius="6" Margin="20"
                BorderBrush="#2A2E39" BorderThickness="1">

            <StackPanel Margin="30">

                <!-- כותרות -->
                <TextBlock Text="מערכת מסחר" FontSize="24" FontWeight="Bold" Foreground="#D1D4DC" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="התחברות מאובטחת לחשבון" FontSize="13" Foreground="#787B86" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- שדה שם משתמש -->
                <TextBlock Text="שם משתמש" FontWeight="SemiBold" Foreground="#B2B5BE" Margin="0,0,0,6" FontSize="12"/>
                <Border CornerRadius="4" Background="#0B0E14" BorderBrush="#2A2E39" BorderThickness="1" Height="40" Margin="0,0,0,15">
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" BorderThickness="0" CaretBrush="#2962FF"
                             VerticalAlignment="Center" Padding="10,0" FontSize="14" Foreground="#D1D4DC"/>
                </Border>

                <!-- שדה סיסמה -->
                <TextBlock Text="סיסמה" FontWeight="SemiBold" Foreground="#B2B5BE" Margin="0,0,0,6" FontSize="12"/>
                <Border CornerRadius="4" Background="#0B0E14" BorderBrush="#2A2E39" BorderThickness="1" Height="40" Margin="0,0,0,8">
                    <PasswordBox x:Name="UserPasswordBox" CaretBrush="#2962FF"
                                 Background="Transparent" BorderThickness="0" 
                                 VerticalAlignment="Center" Padding="10,0" FontSize="14" Foreground="#D1D4DC"/>
                </Border>

                <!-- הודעת שגיאה -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F23645" FontSize="12" Height="18" Margin="0,0,0,15" HorizontalAlignment="Right"/>

                <!-- כפתור התחברות בסגנון לחצן קנייה/Buy -->
                <Button Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=UserPasswordBox}" 
                        Height="42" Margin="0,0,0,25" Cursor="Hand" BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#2962FF" CornerRadius="4">
                                <TextBlock Text="התחבר" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- קישור להרשמה -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="אין לך חשבון?" Foreground="#787B86" Margin="0,0,6,0" FontSize="13"/>
                    <TextBlock Text="פתח חשבון מסחר" Foreground="#2962FF" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>